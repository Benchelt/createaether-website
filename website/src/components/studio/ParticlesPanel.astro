---
const { experience } = Astro.props;
const particles = experience.particles;
---

<div class="panel">

<h2>Particles</h2>

<div class="control-row">
<label>Enabled</label>

<input
type="checkbox"
checked={experience.atmosphere.particles}
/>
</div>

<label>
Count
<output>{particles.count}</output>
</label>

<input
type="range"
min="0"
max="100"
value={particles.count}
/>

<label>Colour</label>

<input
type="color"
value={particles.colour}
/>

<label>
Glow
<output>{particles.glow}</output>
</label>

<input
type="range"
min="0"
max="20"
value={particles.glow}
/>

<label>Radius</label>

<div class="dual-values">
<span>{particles.minRadius}</span>
<span>{particles.maxRadius}</span>
</div>

<label>Speed</label>

<div class="dual-values">
<span>{particles.minSpeed}</span>
<span>{particles.maxSpeed}</span>
</div>

<label>
Drift
<output>{particles.drift}</output>
</label>

<input
type="range"
min="0"
max="20"
value={particles.drift}
/>

<label>Opacity</label>

<div class="dual-values">
<span>{particles.minOpacity}</span>
<span>{particles.maxOpacity}</span>
</div>

<label>Lifetime</label>

<div class="dual-values">
<span>{particles.minLifetime}s</span>
<span>{particles.maxLifetime}s</span>
</div>

</div>

<style>

.panel{
background:#10182c;
border:1px solid rgba(255,255,255,.08);
border-radius:18px;
padding:1.5rem;
}

.panel h2{
margin-top:0;
}

label{
display:flex;
justify-content:space-between;
align-items:center;
margin-top:1rem;
margin-bottom:.45rem;
}

input[type="range"]{
width:100%;
}

input[type="color"]{
width:100%;
height:44px;
border:none;
background:none;
cursor:pointer;
}

.control-row{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:1rem;
}

.dual-values{
display:flex;
justify-content:space-between;
color:#94a3b8;
font-size:.82rem;
margin-bottom:.5rem;
}

output{
color:#7dd3fc;
font-weight:700;
}

</style>
