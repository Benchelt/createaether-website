---
interface Props {
  title: string;
  status: string;
  colour?: "green" | "yellow" | "red";
}

const {
  title,
  status,
  colour = "green",
} = Astro.props;

const colours = {
  green: "#34d399",
  yellow: "#fbbf24",
  red: "#ef4444",
};

const dot = colours[colour];
---

<div class="status-card">
  <div class="status-card__left">
    <span class="status-dot" style={`background:${dot}`}></span>
    <span class="status-title">{title}</span>
  </div>

  <span class="status-value">{status}</span>
</div>

<style>
.status-card{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:16px 20px;
  border:1px solid rgba(255,255,255,.08);
  border-radius:14px;
  background:#10182c;
  transition:.25s ease;
}

.status-card:hover{
  border-color:#2fa8ff;
}

.status-card__left{
  display:flex;
  align-items:center;
  gap:.75rem;
}

.status-dot{
  width:10px;
  height:10px;
  border-radius:50%;
}

.status-title{
  color:#e2e8f0;
  font-weight:600;
}

.status-value{
  color:#94a3b8;
  font-size:.9rem;
}
</style>
