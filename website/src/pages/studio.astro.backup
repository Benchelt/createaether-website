---
import StudioLayout from '../layouts/StudioLayout.astro';
---

<StudioLayout
  title="Studio Dashboard"
  description="Create, configure and manage Aether experiences."
>
  <section class="studio-dashboard">
    <header class="studio-dashboard__header">
      <div>
        <p class="studio-dashboard__eyebrow">Aether Studio</p>
        <h1>Build immersive experiences.</h1>
        <p class="studio-dashboard__intro">
          Configure runtime systems, manage experience presets and monitor
          your Aether workspace from one place.
        </p>
      </div>

      <button type="button" class="studio-dashboard__action">
        Create experience
      </button>
    </header>

    <div class="studio-dashboard__placeholder">
      <span>Studio foundation installed</span>
      <strong>The dashboard components come next.</strong>
    </div>
  </section>
</StudioLayout>

<style>
  .studio-dashboard {
    width: min(100%, 90rem);
    margin-inline: auto;
  }

  .studio-dashboard__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.5rem 0 2.25rem;
  }

  .studio-dashboard__eyebrow {
    margin: 0 0 0.75rem;
    color: #38bdf8;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .studio-dashboard h1 {
    max-width: 50rem;
    margin: 0;
    color: #f8fafc;
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .studio-dashboard__intro {
    max-width: 42rem;
    margin: 1.15rem 0 0;
    color: #94a3b8;
    font-size: 1rem;
    line-height: 1.75;
  }

  .studio-dashboard__action {
    border: 1px solid rgba(125, 211, 252, 0.35);
    border-radius: 0.8rem;
    background: linear-gradient(135deg, #0284c7, #2563eb);
    padding: 0.8rem 1rem;
    color: white;
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 650;
    white-space: nowrap;
    box-shadow: 0 1rem 2.5rem rgba(2, 132, 199, 0.18);
  }

  .studio-dashboard__placeholder {
    display: grid;
    min-height: 24rem;
    place-content: center;
    gap: 0.6rem;
    border: 1px solid rgba(148, 163, 184, 0.14);
    border-radius: 1.35rem;
    background:
      linear-gradient(
        135deg,
        rgba(15, 23, 42, 0.82),
        rgba(8, 15, 29, 0.72)
      );
    text-align: center;
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.025);
  }

  .studio-dashboard__placeholder span {
    color: #38bdf8;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .studio-dashboard__placeholder strong {
    color: #cbd5e1;
    font-size: 1rem;
    font-weight: 500;
  }

  @media (max-width: 720px) {
    .studio-dashboard__header {
      flex-direction: column;
    }

    .studio-dashboard__action {
      width: 100%;
    }
  }
</style>
