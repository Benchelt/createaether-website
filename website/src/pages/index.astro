---
import ExperiencePanel from '../components/ExperiencePanel.astro';

const principles = [
  {
    title: 'Modular by design',
    text: 'Composable systems that can evolve without tightly coupling every feature.',
  },
  {
    title: 'Performance by default',
    text: 'Immersive experiences should enhance a website without making it slow.',
  },
  {
    title: 'Developer first',
    text: 'Clear architecture, practical documentation and predictable behaviour.',
  },
  {
    title: 'Built to grow',
    text: 'A foundation for today’s engine and tomorrow’s platform services.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta
      name="description"
      content="Aether is a modular platform for creating immersive digital experiences."
    />
    <title>Aether — Build immersive digital experiences</title>
      <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Aether home">
        <img
          src="/brand/aether-mark.svg"
          alt="Create Aether"
          class="brand-logo"
          width="52"
          height="52"
        />
        <span>Create Aether</span>
      </a>

      <nav aria-label="Primary navigation">
        <a href="#platform">Platform</a>
        <a href="#principles">Principles</a>
        <a
          href="https://github.com/Benchelt/createaether-website"
          target="_blank"
          rel="noreferrer"
        >
          GitHub
        </a>
      </nav>
    </header>

    <main>
      <section
        class="hero"
        data-aether-demo
        data-experience="temple"
        data-particles="true"
        data-glow="true"
      >
        <div class="hero-grid" aria-hidden="true"></div>
        <div
          class="hero-particles"
          data-aether-particles
          aria-hidden="true"
        ></div>

        <div class="hero-content">
          <p class="eyebrow">A modular experience platform</p>

          <h1>Build immersive digital experiences.</h1>

          <p class="hero-copy">
            Aether combines atmosphere, interaction and elegant engineering
            to help developers create richer experiences for the web.
          </p>

          <div class="actions">
            <a class="button primary" href="#platform">Explore Aether</a>
            <a
              class="button secondary"
              href="https://github.com/Benchelt/createaether-website"
              target="_blank"
              rel="noreferrer"
            >
              View on GitHub
            </a>
          </div>

          <div class="status" aria-label="Project status">
            <span>Open development</span>
            <span>Astro foundation</span>
            <span>Python-ready roadmap</span>
          </div>
        </div>

        <div class="hero-visual">
          <p class="demo-label">
            <span aria-hidden="true"></span>
            Live Aether Demo
          </p>
          <div class="aether-field" aria-hidden="true">
            <div class="field-glow"></div>

            <div class="field-rings">
              <span></span>
              <span></span>
              <span></span>
              <span></span>
            </div>

            <div class="energy-line"></div>

            <img
              src="/brand/aether-mark.svg"
              alt=""
              class="hero-mark"
              width="320"
              height="320"
            />
          </div>

          <ExperiencePanel />
        </div>
      </section>

      <section id="platform" class="platform">
        <div>
          <p class="eyebrow">Aether Engine</p>
          <h2>A focused runtime for atmosphere and interaction.</h2>
        </div>

        <p>
          The platform begins with a modular experience engine designed to
          coordinate audio, visual effects, contextual behaviour and
          user-controlled ambience.
        </p>
      </section>

      <section id="principles" class="principles">
        {
          principles.map((principle) => (
            <article>
              <h3>{principle.title}</h3>
              <p>{principle.text}</p>
            </article>
          ))
        }
      </section>
    </main>

    <footer>
      <p>© 2026 Aether. Built with Astro.</p>
    </footer>
  </body>
</html>

<style>
  :root {
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    color: #f4efe7;
    background: #090b0f;
    font-synthesis: none;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-width: 320px;
    background:
      radial-gradient(circle at 75% 10%, rgba(117, 92, 255, 0.16), transparent 34rem),
      radial-gradient(circle at 10% 35%, rgba(58, 177, 156, 0.09), transparent 28rem),
      #090b0f;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding: 34px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  
.brand-logo {
  width: 52px;
  height: 52px;
  display: block;
  flex-shrink: 0;
}

.brand span {
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.brand {
    display: flex;
    align-items: center;
    gap: 14px;

    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.06em;

    color: #ffffff;
}

  nav {
    display: flex;
    gap: 28px;
    color: #aaaeb8;
    font-size: 0.92rem;
  }

  nav a:hover {
    color: #ffffff;
  }

  main,
  footer {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
  }

  .hero {
    min-height: 720px;
    padding: 90px 0 100px;
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(340px, 0.82fr);
    align-items: center;
    gap: clamp(48px, 7vw, 110px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    min-width: 0;
  }

  .hero-visual {
    position: relative;
    min-height: 720px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .aether-field {
    position: relative;
    width: min(100%, 440px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    isolation: isolate;
    margin-bottom: -34px;
  }

  .field-glow {
    position: absolute;
    inset: 15%;
    border-radius: 50%;
    background:
      radial-gradient(
        circle,
        rgba(102, 227, 255, 0.22) 0%,
        rgba(79, 124, 255, 0.16) 28%,
        rgba(101, 71, 255, 0.08) 52%,
        transparent 72%
      );
    filter: blur(18px);
    animation: aether-pulse 7s ease-in-out infinite;
  }

  .hero-mark {
    position: relative;
    z-index: 3;
    width: min(62%, 320px);
    height: auto;
    filter:
      drop-shadow(0 0 18px rgba(102, 227, 255, 0.28))
      drop-shadow(0 24px 42px rgba(79, 124, 255, 0.25));
    animation: aether-float 7s ease-in-out infinite;
  }

  .energy-line {
    position: absolute;
    z-index: 2;
    top: 48%;
    bottom: 12%;
    width: 2px;
    background:
      linear-gradient(
        to bottom,
        rgba(102, 227, 255, 0),
        rgba(102, 227, 255, 0.95),
        rgba(79, 124, 255, 0)
      );
    box-shadow:
      0 0 12px rgba(102, 227, 255, 0.8),
      0 0 28px rgba(79, 124, 255, 0.45);
  }

  .field-rings {
    position: absolute;
    z-index: 1;
    left: 50%;
    bottom: 7%;
    width: 82%;
    aspect-ratio: 2.7 / 1;
    transform: translateX(-50%);
  }

  .field-rings span {
    position: absolute;
    inset: 50%;
    border: 1px solid rgba(79, 124, 255, 0.42);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 16px rgba(79, 124, 255, 0.12);
    animation: ring-breathe 6s ease-in-out infinite;
  }

  .field-rings span:nth-child(1) {
    width: 32%;
    height: 32%;
  }

  .field-rings span:nth-child(2) {
    width: 52%;
    height: 52%;
    animation-delay: -1.2s;
  }

  .field-rings span:nth-child(3) {
    width: 74%;
    height: 74%;
    animation-delay: -2.4s;
  }

  .field-rings span:nth-child(4) {
    width: 100%;
    height: 100%;
    animation-delay: -3.6s;
  }

  @keyframes aether-float {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }

    50% {
      transform: translateY(-14px) scale(1.015);
    }
  }

  @keyframes aether-pulse {
    0%,
    100% {
      opacity: 0.62;
      transform: scale(0.96);
    }

    50% {
      opacity: 1;
      transform: scale(1.05);
    }
  }

  @keyframes ring-breathe {
    0%,
    100% {
      opacity: 0.35;
      transform: translate(-50%, -50%) scale(0.96);
    }

    50% {
      opacity: 0.82;
      transform: translate(-50%, -50%) scale(1.04);
    }
  }

  .eyebrow {
    margin: 0 0 22px;
    color: #9e91ff;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 920px;
    margin: 0;
    font-size: clamp(3.7rem, 8vw, 7.8rem);
    line-height: 0.94;
    letter-spacing: -0.065em;
  }

  .hero-copy {
    max-width: 680px;
    margin: 38px 0 0;
    color: #a9adb6;
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    line-height: 1.7;
  }

  .actions {
    margin-top: 42px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .button {
    min-height: 48px;
    padding: 0 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    font-weight: 650;
  }

  .button.primary {
    color: #090b0f;
    background: #f4efe7;
  }

  .button.secondary {
    background: rgba(255, 255, 255, 0.035);
  }

  .status {
    margin-top: 62px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .status span {
    padding: 9px 13px;
    color: #a9adb6;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    font-size: 0.82rem;
  }

  .platform {
    padding: 120px 0;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 80px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  h2 {
    max-width: 720px;
    margin: 0;
    font-size: clamp(2.3rem, 5vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .platform > p {
    align-self: end;
    margin: 0;
    color: #a9adb6;
    font-size: 1.12rem;
    line-height: 1.8;
  }

  .principles {
    padding: 110px 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  article {
    min-height: 230px;
    padding: 28px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.025);
  }

  h3 {
    margin: 0 0 18px;
    font-size: 1.1rem;
  }

  article p {
    margin: 0;
    color: #989da8;
    line-height: 1.7;
  }

  footer {
    padding: 34px 0 50px;
    color: #777d89;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.86rem;
  }

  @media (max-width: 800px) {
    nav {
      gap: 16px;
    }

    .hero {
      min-height: auto;
      padding: 100px 0 80px;
    }

    .platform,
    .principles {
      grid-template-columns: 1fr;
    }

    .platform {
      gap: 42px;
    }
  }

  @media (max-width: 560px) {
    .site-header {
      align-items: flex-start;
    }

    nav a:not(:last-child) {
      display: none;
    }

    h1 {
      font-size: 3.5rem;
    }
  }

  @media (max-width: 980px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 100px;
    }

    .hero-visual {
      min-height: 430px;
    }

    .aether-field {
      width: min(100%, 460px);
    }
  }

  @media (max-width: 560px) {
    .hero {
      padding-top: 72px;
      gap: 30px;
    }

    .hero-visual {
      min-height: 330px;
    }

    .hero-mark {
      width: min(58%, 230px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-mark,
    .field-glow,
    .field-rings span {
      animation: none;
    }
  }


  /* AETHER INTERACTIVE DEMO */

  .hero[data-aether-demo] {
    --aether-accent: #66e3ff;
    --aether-secondary: #6674ff;
    --aether-deep: #281f78;
    --aether-power: 0.65;

    position: relative;
    isolation: isolate;
    overflow: hidden;
    transition:
      background-color 600ms ease,
      border-color 600ms ease;
  }

  .hero[data-experience="temple"] {
    --aether-accent: #8f83ff;
    --aether-secondary: #4f7cff;
    --aether-deep: #3927a4;
  }

  .hero[data-experience="forest"] {
    --aether-accent: #62dfa6;
    --aether-secondary: #9bcf68;
    --aether-deep: #164f3b;
  }

  .hero[data-experience="ocean"] {
    --aether-accent: #55ddff;
    --aether-secondary: #3d83ff;
    --aether-deep: #154d89;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    z-index: -3;
    pointer-events: none;
    opacity: calc(0.12 + var(--aether-power) * 0.14);
    background-image:
      linear-gradient(
        color-mix(
          in srgb,
          var(--aether-accent) 12%,
          transparent
        ) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        color-mix(
          in srgb,
          var(--aether-accent) 12%,
          transparent
        ) 1px,
        transparent 1px
      );
    background-size: 64px 64px;
    mask-image:
      radial-gradient(
        ellipse at 74% 42%,
        black 0%,
        rgba(0, 0, 0, 0.58) 42%,
        transparent 74%
      );
    animation: aether-grid-drift 24s linear infinite;
    transition: opacity 500ms ease;
  }

  .hero::before {
    position: absolute;
    inset: -15%;
    z-index: -4;
    content: "";
    pointer-events: none;
    opacity: calc(0.24 + var(--aether-power) * 0.54);
    background:
      radial-gradient(
        circle at 78% 28%,
        color-mix(
          in srgb,
          var(--aether-accent) 22%,
          transparent
        ),
        transparent 27%
      ),
      radial-gradient(
        circle at 90% 66%,
        color-mix(
          in srgb,
          var(--aether-secondary) 11%,
          transparent
        ),
        transparent 32%
      );
    filter: blur(16px);
    transition:
      opacity 500ms ease,
      background 700ms ease;
  }

  .hero[data-glow="false"]::before,
  .hero[data-glow="false"] .field-glow {
    opacity: 0;
  }

  .hero-content {
    z-index: 4;
  }

  .hero-visual {
    z-index: 3;
  }

  .demo-label {
    position: relative;
    z-index: 6;
    margin: 0 0 -28px;
    display: flex;
    align-items: center;
    gap: 9px;
    color: #aab5ca;
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .demo-label span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--aether-accent);
    box-shadow:
      0 0 10px var(--aether-accent),
      0 0 22px var(--aether-accent);
  }

  .field-glow {
    opacity: calc(0.4 + var(--aether-power) * 0.6);
    background:
      radial-gradient(
        circle,
        color-mix(
          in srgb,
          var(--aether-accent) 30%,
          transparent
        ) 0%,
        color-mix(
          in srgb,
          var(--aether-secondary) 18%,
          transparent
        ) 30%,
        color-mix(
          in srgb,
          var(--aether-deep) 10%,
          transparent
        ) 54%,
        transparent 73%
      );
    transition:
      opacity 500ms ease,
      background 650ms ease;
  }

  .hero-mark {
    filter:
      drop-shadow(
        0 0 calc(12px + var(--aether-power) * 18px)
        color-mix(
          in srgb,
          var(--aether-accent) 52%,
          transparent
        )
      )
      drop-shadow(
        0 28px 45px
        color-mix(
          in srgb,
          var(--aether-secondary) 29%,
          transparent
        )
      );
    animation-duration:
      calc(9s - var(--aether-power) * 3s);
    transition: filter 600ms ease;
  }

  .energy-line {
    bottom: -30px;
    background:
      linear-gradient(
        to bottom,
        transparent,
        var(--aether-accent),
        var(--aether-secondary),
        transparent
      );
    box-shadow:
      0 0 12px var(--aether-accent),
      0 0 30px var(--aether-secondary);
    opacity: calc(0.42 + var(--aether-power) * 0.58);
    transition:
      background 600ms ease,
      box-shadow 600ms ease,
      opacity 400ms ease;
  }

  .field-rings span {
    border-color:
      color-mix(
        in srgb,
        var(--aether-secondary) 52%,
        transparent
      );
    box-shadow:
      0 0 18px
      color-mix(
        in srgb,
        var(--aether-secondary) 18%,
        transparent
      );
    animation-duration:
      calc(8s - var(--aether-power) * 3s);
    transition:
      border-color 600ms ease,
      box-shadow 600ms ease;
  }

  .hero-particles {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    opacity: calc(0.22 + var(--aether-power) * 0.67);
    mask-image:
      radial-gradient(
        ellipse at 75% 45%,
        black,
        transparent 77%
      );
    transition: opacity 450ms ease;
  }

  .hero-particles span {
    position: absolute;
    top: var(--particle-top);
    left: var(--particle-left);
    width: var(--particle-size);
    height: var(--particle-size);
    border-radius: 50%;
    background: var(--aether-accent);
    box-shadow:
      0 0 8px var(--aether-accent),
      0 0 16px var(--aether-secondary);
    opacity: 0;
    animation:
      aether-particle-rise
      var(--particle-duration)
      ease-in-out
      var(--particle-delay)
      infinite;
  }

  .hero[data-particles="false"] .hero-particles {
    opacity: 0;
  }

  @keyframes aether-grid-drift {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(64px, 64px, 0);
    }
  }

  @keyframes aether-particle-rise {
    0% {
      opacity: 0;
      transform: translate3d(0, 18px, 0) scale(0.75);
    }

    20% {
      opacity: 0.72;
    }

    70% {
      opacity: 0.35;
    }

    100% {
      opacity: 0;
      transform:
        translate3d(
          var(--particle-drift),
          -90px,
          0
        )
        scale(1.15);
    }
  }

  @media (max-width: 980px) {
    .demo-label {
      margin-bottom: -12px;
    }

    .hero-grid {
      mask-image:
        linear-gradient(
          to bottom,
          transparent,
          black 24%,
          transparent
        );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-grid,
    .hero-particles span {
      animation: none;
    }

    .hero-particles {
      display: none;
    }
  }

</style>
