---
const principles = [
  {
    title: 'Modular by design',
    text: 'Composable systems that can evolve without tightly coupling every feature.',
  },
  {
    title: 'Performance by default',
    text: 'Immersive experiences should enhance a website without making it slow.',
  },
  {
    title: 'Developer first',
    text: 'Clear architecture, practical documentation and predictable behaviour.',
  },
  {
    title: 'Built to grow',
    text: 'A foundation for today’s engine and tomorrow’s platform services.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta
      name="description"
      content="Aether is a modular platform for creating immersive digital experiences."
    />
    <title>Aether — Build immersive digital experiences</title>
  </head>

  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Aether home">
        AETHER
      </a>

      <nav aria-label="Primary navigation">
        <a href="#platform">Platform</a>
        <a href="#principles">Principles</a>
        <a
          href="https://github.com/Benchelt/createaether-website"
          target="_blank"
          rel="noreferrer"
        >
          GitHub
        </a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow">A modular experience platform</p>

        <h1>Build immersive digital experiences.</h1>

        <p class="hero-copy">
          Aether combines atmosphere, interaction and elegant engineering
          to help developers create richer experiences for the web.
        </p>

        <div class="actions">
          <a class="button primary" href="#platform">Explore Aether</a>
          <a
            class="button secondary"
            href="https://github.com/Benchelt/createaether-website"
            target="_blank"
            rel="noreferrer"
          >
            View on GitHub
          </a>
        </div>

        <div class="status" aria-label="Project status">
          <span>Open development</span>
          <span>Astro foundation</span>
          <span>Python-ready roadmap</span>
        </div>
      </section>

      <section id="platform" class="platform">
        <div>
          <p class="eyebrow">Aether Engine</p>
          <h2>A focused runtime for atmosphere and interaction.</h2>
        </div>

        <p>
          The platform begins with a modular experience engine designed to
          coordinate audio, visual effects, contextual behaviour and
          user-controlled ambience.
        </p>
      </section>

      <section id="principles" class="principles">
        {
          principles.map((principle) => (
            <article>
              <h3>{principle.title}</h3>
              <p>{principle.text}</p>
            </article>
          ))
        }
      </section>
    </main>

    <footer>
      <p>© 2026 Aether. Built with Astro.</p>
    </footer>
  </body>
</html>

<style>
  :root {
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    color: #f4efe7;
    background: #090b0f;
    font-synthesis: none;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-width: 320px;
    background:
      radial-gradient(circle at 75% 10%, rgba(117, 92, 255, 0.16), transparent 34rem),
      radial-gradient(circle at 10% 35%, rgba(58, 177, 156, 0.09), transparent 28rem),
      #090b0f;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding: 28px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    font-size: 0.9rem;
    font-weight: 750;
    letter-spacing: 0.24em;
  }

  nav {
    display: flex;
    gap: 28px;
    color: #aaaeb8;
    font-size: 0.92rem;
  }

  nav a:hover {
    color: #ffffff;
  }

  main,
  footer {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
  }

  .hero {
    min-height: 720px;
    padding: 130px 0 100px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .eyebrow {
    margin: 0 0 22px;
    color: #9e91ff;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 920px;
    margin: 0;
    font-size: clamp(3.7rem, 8vw, 7.8rem);
    line-height: 0.94;
    letter-spacing: -0.065em;
  }

  .hero-copy {
    max-width: 680px;
    margin: 38px 0 0;
    color: #a9adb6;
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    line-height: 1.7;
  }

  .actions {
    margin-top: 42px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .button {
    min-height: 48px;
    padding: 0 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    font-weight: 650;
  }

  .button.primary {
    color: #090b0f;
    background: #f4efe7;
  }

  .button.secondary {
    background: rgba(255, 255, 255, 0.035);
  }

  .status {
    margin-top: 62px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .status span {
    padding: 9px 13px;
    color: #a9adb6;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    font-size: 0.82rem;
  }

  .platform {
    padding: 120px 0;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 80px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  h2 {
    max-width: 720px;
    margin: 0;
    font-size: clamp(2.3rem, 5vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .platform > p {
    align-self: end;
    margin: 0;
    color: #a9adb6;
    font-size: 1.12rem;
    line-height: 1.8;
  }

  .principles {
    padding: 110px 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  article {
    min-height: 230px;
    padding: 28px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.025);
  }

  h3 {
    margin: 0 0 18px;
    font-size: 1.1rem;
  }

  article p {
    margin: 0;
    color: #989da8;
    line-height: 1.7;
  }

  footer {
    padding: 34px 0 50px;
    color: #777d89;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.86rem;
  }

  @media (max-width: 800px) {
    nav {
      gap: 16px;
    }

    .hero {
      min-height: auto;
      padding: 100px 0 80px;
    }

    .platform,
    .principles {
      grid-template-columns: 1fr;
    }

    .platform {
      gap: 42px;
    }
  }

  @media (max-width: 560px) {
    .site-header {
      align-items: flex-start;
    }

    nav a:not(:last-child) {
      display: none;
    }

    h1 {
      font-size: 3.5rem;
    }
  }
</style>
